# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local
.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE / OS
.vscode/
.idea/
Thumbs.db

# Claude Code local config
.claude/

# Supabase CLI temp
/supabase/.temp/

# Assets réflexo copiés au build depuis reflexologie/ (source de vérité) :
# visuels des protocoles + illustration SVG des pieds. Régénérés par
# scripts/sync-reflexo-visuels.mjs (lancé par `npm run dev` et `build`).
/public/reflexologie/

# Documents de travail (nuanciers, aperçus) — générés à la demande,
# gardés en local par Laura, pas dans le dépôt.
/docs/

# Brouillons de contenu remplacés — gardés en local, jamais importés.
content/**/*_anciens/

# Sauvegardes prises avant une passe de réécriture (« l'état d'avant »).
# Elles doublonnent l'historique git, qui garde déjà chaque version.
content/**/_avant_*/
content/_avant_*/

# Dossiers de travail locaux, hors application : veille concurrentielle,
# sauvegardes de dossiers entiers, versions archivées. Volumineux (100 Mo+),
# ils n'ont rien à faire dans le dépôt.
/Concurrence/
/_sauvegardes/
/_anciens/

# Python
__pycache__/
*.pyc

# Sauvegardes de fichiers isolés prises avant réécriture.
content/**/_avant_*.json
