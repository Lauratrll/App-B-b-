# ============================================================
# BeSerene — variables d'environnement
# ============================================================
# Copier ce fichier vers .env.local et remplir avec vos vraies valeurs.
# .env.local est ignoré par git (cf. .gitignore).
# Ne jamais commiter de vraies clés dans le dépôt.
# ============================================================

# ----- Supabase ---------------------------------------------
# Récupérables sur https://supabase.com/dashboard
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=<votre-url-supabase>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<votre-clef-anon-publique>
SUPABASE_SERVICE_ROLE_KEY=<votre-clef-service-role-secrete>

# ----- Stripe -----------------------------------------------
# Récupérables sur https://dashboard.stripe.com/apikeys
# En dev : clés "test" (préfixe sk_test_ / pk_test_)
STRIPE_SECRET_KEY=<votre-clef-secrete-stripe>
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=<votre-clef-publishable-stripe>
STRIPE_WEBHOOK_SECRET=<votre-webhook-secret-stripe>

# IDs des prix Stripe pour les 2 formules d'abonnement
# https://dashboard.stripe.com/products
STRIPE_PRICE_ID_MONTHLY=<votre-price-id-mensuel>
STRIPE_PRICE_ID_ANNUAL=<votre-price-id-annuel>

# ----- Resend (emails) --------------------------------------
# Récupérable sur https://resend.com/api-keys
RESEND_API_KEY=<votre-clef-resend>
RESEND_FROM_EMAIL=hello@votre-domaine.fr

# ----- App --------------------------------------------------
# URL de base de l'app (utilisée pour les redirects auth et Stripe)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----- Revalidate cache contenu -----------------------------
# Utilisé par scripts/import-content.mjs pour invalider le cache
# de l'app après un import. Génère un secret aléatoire long.
REVALIDATE_SECRET=changeme-en-une-longue-chaine-aleatoire
REVALIDATE_URL=http://localhost:3000/api/revalidate-content
# (en prod : https://app-b-b-i6ai.vercel.app/api/revalidate-content)
